# Caddyfile - CVMC Backend Reverse Proxy (Cloudflare Full SSL)
# https://caddyserver.com/docs/caddyfile

api.cvmc.yurinogueira.dev.br {
    # Certificado TLS local confiável para comunicação com o proxy Cloudflare (SSL Full)
    tls internal

    # Habilita compressão moderna
    encode zstd gzip

    # Proxy reverso para o serviço Go rodando localmente
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Cabeçalhos de segurança
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Logs estruturados em formato JSON
    log {
        output file /var/log/caddy/cvmc_api.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
