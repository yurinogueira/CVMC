# Configurações do Backend CVMC (/etc/cvmc/backend.env)
PORT=8080
LOG_LEVEL=info
STORAGE_PROVIDER=local
UPLOAD_PATH=/opt/cvmc/data/uploads

# Domínios e CORS (Produção)
ALLOWED_ORIGINS=https://cvmc.yurinogueira.dev.br
COOKIE_DOMAIN=.yurinogueira.dev.br
COOKIE_SECURE=true

# MongoDB Atlas (Substitua pela connection string gerada no Terraform output 'mongodb_uri')
MONGO_URI=mongodb+srv://cvmc_app:<SENHA>@cvmc-cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=cvmc

# Secrets de Autenticação JWT (Gere com: openssl rand -base64 32)
JWT_SECRET=substitua_por_uma_chave_secreta_jwt_forte
JWT_REFRESH_SECRET=substitua_por_uma_chave_secreta_refresh_forte
